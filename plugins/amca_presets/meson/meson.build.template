project('CHANGEME', ['c'],
  version : '0.1',
  default_options : [
    'warning_level=3',
    'c_std=c17',
    'buildtype=release',
    'optimization=3',
    'debug=false',
  ])

# ── amca variables ───────────────────────────────────────────────────────────
# The amca meson plugin reads these by name. Keep the names; move the block
# wherever you like. Regenerate this file with:  amca ---meson --print-template
amca_var__meson__version_behaviour = '2.0.1'      # template contract version
amca_var__meson__build_dir         = 'build'      # relative to this file
amca_var__meson__executable_name   = 'a'
amca_var__meson__install_dir       = '../compiled' # relative to build_dir
# ── end amca variables ───────────────────────────────────────────────────────

# Source discovery. Globbing is not native to meson, so this shells out to
# python once at configure time. amca's `reconfigure` step re-runs meson only
# when the *set* of source files changes, so this stays cheap.
_glob_script = '''
import pathlib, sys
build = sys.argv[1]
prune = {'.git', '.hg', '.svn', 'subprojects', 'node_modules', '__pycache__'}
seen = []
for ext in ('*.c', '*.cpp', '*.cxx', '*.cc'):
    for p in sorted(pathlib.Path('.').rglob(ext)):
        parts = set(p.parts)
        if build in p.parts[:1] or parts & prune:
            continue
        s = p.as_posix()
        if s not in seen:
            seen.append(s)
# Write bytes directly: print() would translate \n to \r\n on Windows, and
# meson's split('\n') would then leave a stray \r on every path.
sys.stdout.buffer.write('\n'.join(seen).encode('utf-8'))
sys.stdout.buffer.flush()
'''

_python = find_program('python3', 'python')

source_files = run_command(
  _python, '-c', _glob_script,
  amca_var__meson__build_dir,
  check : true,
).stdout().strip().split('\n')

output_dir = meson.project_build_root() / amca_var__meson__install_dir

executable(amca_var__meson__executable_name,
  source_files,
  install     : true,
  install_dir : output_dir)
